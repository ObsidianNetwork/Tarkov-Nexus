# Repository root — the Tarkov Nexus desktop application (Go + Wails).
# The Astro website has its own .gitignore in website/.

# Go build output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/bin

# Node / build artefacts (any depth: root installs, website, ui-wails frontend)
node_modules/
dist/
.astro/

# Wails build artefacts
ui-wails/build/bin/

# Generated Wails bindings are committed; local runtime copies are not
ui-wails/frontend/package.json.md5

# Local configuration and runtime state — never commit these
config.json
config2.json
ui-wails/config.json
ui-wails/config2.json
ui-wails/logs/
party-server/party.db
.env
.env.local
.env.*.local

# Agent tooling
.omo/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
