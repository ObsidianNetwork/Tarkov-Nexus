---
// Floating feedback button → GitHub issue chooser.
// Lives above the FAB z-layer but below the notice; the notice offsets its
// bottom position so the two never overlap (see Notice.astro).
const feedbackUrl = 'https://github.com/ObsidianNetwork/Tarkov-Nexus/issues/new/choose';
---

<a href={feedbackUrl} target="_blank" rel="noopener" class="feedback-fab" data-analytics="feedback" data-entry-point="fab" aria-label="Send feedback or report an issue on GitHub">
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
  <span class="feedback-fab-label">Feedback</span>
</a>
