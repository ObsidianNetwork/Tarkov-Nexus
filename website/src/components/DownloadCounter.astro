---
import { RELEASES_API } from '../lib/github';

interface Props {
  variant?: 'hero' | 'inline';
  /** 'beta' counts only prerelease/beta-tagged releases; default is all releases. */
  channel?: 'stable' | 'beta';
}

const { variant = 'inline', channel } = Astro.props;
// No build-time number: the count is always fetched live in the browser, so a
// page served from cache can never show a stale total.
---

{variant === 'hero' ? (
  <div class="counter-hero is-loading" data-counter data-downloads-api={RELEASES_API}>
    <span class="counter-pulse" aria-hidden="true"></span>
    <span class="counter-value" data-downloads aria-live="polite" aria-busy="true">
      <span class="counter-skeleton" aria-hidden="true"></span>
      <span class="visually-hidden">Loading download count</span>
    </span>
    <span class="counter-label">downloads worldwide</span>
  </div>
) : (
  <p class="counter-inline is-loading" data-counter data-channel={channel} data-downloads-api={RELEASES_API}>
    <span data-downloads aria-live="polite" aria-busy="true">
      <span class="counter-skeleton" aria-hidden="true"></span>
      <span class="visually-hidden">Loading download count</span>
    </span>
    <span class="counter-suffix">{channel === 'beta' ? 'beta downloads' : 'downloads worldwide'}</span>
  </p>
)}

<noscript>
  <style>[data-counter] { display: none !important; }</style>
</noscript>

<style>
  .counter-hero {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0 0.85rem;
    padding: 1.5rem 2.25rem;
    margin-bottom: 2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    transition: opacity 0.3s ease;
  }

  /* A counter that never resolved is worse than no counter at all. */
  .counter-hero[hidden],
  .counter-inline[hidden] {
    display: none;
  }

  .counter-pulse {
    align-self: center;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: 0 0 0 0 var(--neon-green);
    animation: counter-pulse 2.4s ease-out infinite;
  }

  @keyframes counter-pulse {
    70% {
      box-shadow: 0 0 0 12px rgba(0, 0, 0, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    }
  }

  .counter-value {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--primary-purple), var(--neon-green));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .counter-label {
    grid-column: 2;
    margin-top: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .counter-inline {
    margin: 0 0 2rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .counter-inline [data-downloads] {
    color: var(--neon-green);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-right: 0.4rem;
  }

  /* Skeleton: reserves the width of a realistic number so nothing shifts on load. */
  .counter-skeleton {
    display: inline-block;
    width: 5ch;
    height: 0.8em;
    vertical-align: baseline;
    border-radius: 6px;
    background: linear-gradient(
      90deg,
      var(--border-color) 25%,
      rgba(255, 255, 255, 0.08) 50%,
      var(--border-color) 75%
    );
    background-size: 200% 100%;
    animation: counter-shimmer 1.4s ease-in-out infinite;
  }

  .counter-inline .counter-skeleton {
    width: 4ch;
    height: 0.9em;
    border-radius: 4px;
  }

  @keyframes counter-shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .counter-pulse,
    .counter-skeleton {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .counter-hero {
      justify-content: center;
    }

    .counter-value {
      font-size: 2.5rem;
    }
  }
</style>

<script>
  const counters = document.querySelectorAll<HTMLElement>('[data-counter]');
  const api = counters[0]?.dataset.downloadsApi;

  if (api) {
    fetch(api)
      .then((res) => (res.ok ? res.json() : Promise.reject(new Error(String(res.status)))))
      .then((releases) => {
        if (!Array.isArray(releases)) throw new Error('unexpected payload');

        const assetSum = (release: any) =>
          (release.assets ?? []).reduce(
            (assetSum: number, asset: any) =>
              /\.(zip|exe|msi)$/i.test(asset.name)
                ? assetSum + (asset.download_count ?? 0)
                : assetSum,
            0
          );

        const total = releases.reduce((sum: number, release: any) => sum + assetSum(release), 0);
        const betaTotal = releases
          .filter(
            (release: any) =>
              release.prerelease || /beta|alpha|rc/i.test(release.tag_name ?? '')
          )
          .reduce((sum: number, release: any) => sum + assetSum(release), 0);
        if (total <= 0) throw new Error('no downloads reported');

        const targets: { el: HTMLElement; value: number }[] = [];
        counters.forEach((counter) => {
          const value = counter.dataset.channel === 'beta' ? betaTotal : total;
          const el = counter.querySelector<HTMLElement>('[data-downloads]');
          if (el) {
            // Announce the final number once, not every animation frame.
            el.textContent = value.toLocaleString('en-US');
            el.setAttribute('aria-busy', 'false');
            targets.push({ el, value });
          }
          counter.classList.remove('is-loading');
        });

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || targets.length === 0) return;

        // Count up from a near-total start: the point is to draw the eye to a
        // live number, not to imply the app was downloaded 0 times a second ago.
        const duration = 1100;
        const begin = performance.now();

        const tick = (now: number) => {
          const progress = Math.min((now - begin) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          targets.forEach(({ el, value }) => {
            const start = Math.floor(value * 0.9);
            el.textContent = Math.round(start + (value - start) * eased).toLocaleString('en-US');
          });
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      })
      .catch(() => {
        // Rate limited, offline, or blocked: hide rather than shimmer forever.
        counters.forEach((counter) => {
          counter.hidden = true;
        });
      });
  }
</script>
