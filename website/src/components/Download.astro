---
import { getLatestRelease } from '../lib/github';
import DownloadCounter from './DownloadCounter.astro';

const { version, downloadUrl } = await getLatestRelease();

// ── Beta channel ─────────────────────────────────────────────────────────────
// Live beta release. When a new beta ships, update `url` and `version` here.
const BETA = {
  version: 'v3.3.4-beta.1',
  url: 'https://github.com/ObsidianNetwork/Tarkov-Nexus/releases/download/v3.3.4-beta.1/TarkovNexus-v3.3.4-beta.1-Windows-x64.zip'
};

const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;

const requirements = [
  "Windows 10/11 (64-bit)",
  "Escape from Tarkov",
  "Modern web browser"
];
---

<section class="download" id="download">
  <div class="container">
    <div class="section-header section-header--center reveal">
      <span class="eyebrow">Download</span>
      <h2>Ready to Try Tarkov Nexus?</h2>
      <p>Free and built for the community &mdash; stable for everyday raids, beta for the bold</p>
    </div>

    <div class="download-grid">
      <div class="download-card reveal">
        <span class="channel-chip channel-chip--stable">Stable</span>
        <h2>Tarkov Nexus</h2>
        <div class="version-badge">Latest Version: <span>{version}</span></div>
        <DownloadCounter />
        <div class="download-buttons">
          <a href={downloadUrl} class="btn btn-primary" data-analytics="download" data-channel="stable">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Download for Windows (x64)
          </a>
          <a href="https://github.com/ObsidianNetwork/Tarkov-Nexus/releases" target="_blank" class="btn btn-secondary" data-analytics="nav" data-nav-item="all-releases">
            All Releases
          </a>
        </div>
        <div class="system-req">
          <h4>Requirements</h4>
          <ul>
            {requirements.map((req) => (
              <li>
                <Fragment set:html={checkIcon} />
                {req}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="download-card download-card--beta reveal" id="beta" style="--reveal-delay: 100ms">
        <span class="channel-chip channel-chip--beta">Beta</span>
        <h2>Join the Beta</h2>
        <p>Get early access to new features before they ship to everyone. Expect faster iterations and the occasional rough edge.</p>
        <div class="version-badge version-badge--beta">Beta Version: <span>{BETA.version}</span></div>
        <div class="download-buttons">
          <a href={BETA.url} class="btn btn-beta" data-analytics="download" data-channel="beta">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Download Beta
          </a>
        </div>
        <p class="beta-note">
          Found something odd? <a href="https://github.com/ObsidianNetwork/Tarkov-Nexus/issues/new/choose" target="_blank" data-analytics="feedback" data-entry-point="beta-card">Report it on GitHub</a> &mdash; beta feedback goes straight to the top of the list.
        </p>
      </div>
    </div>
  </div>
</section>
