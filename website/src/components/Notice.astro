---
// ── Site notice ──────────────────────────────────────────────────────────────
// To take the notice down: set `active: false`. Nothing else to touch.
// Changing `id` re-shows the notice to people who already dismissed the old one.
const notice = {
  active: true,
  id: 'map-tracker-outage-2026-08',
  title: 'Map tracker is currently down',
  body: 'Position syncing is not working right now. We are actively working on a fix — downloads and everything else are unaffected.',
  linkLabel: 'Follow progress on GitHub',
  linkUrl: 'https://github.com/ObsidianNetwork/Tarkov-Nexus/issues/2'
};
---

{notice.active && (
  <aside
    class="notice"
    data-notice={notice.id}
    role="status"
    aria-live="polite"
    aria-label="Site notice"
    hidden
  >
    <span class="notice-dot" aria-hidden="true"></span>
    <div class="notice-body">
      <p class="notice-title">{notice.title}</p>
      <p class="notice-text">{notice.body}</p>
      <a href={notice.linkUrl} target="_blank" rel="noopener" class="notice-link">
        {notice.linkLabel}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
      </a>
    </div>
    <button type="button" class="notice-close" data-notice-dismiss aria-label="Dismiss notice">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
    </button>
  </aside>
)}

<style>
  /* Floats above the page: never shifts or reflows the site content. */
  .notice {
    position: fixed;
    right: 1.5rem;
    /* Sits above the feedback FAB so the two never overlap. */
    bottom: 5.25rem;
    z-index: 200;
    display: flex;
    gap: 0.85rem;
    width: min(380px, calc(100vw - 3rem));
    padding: 1.15rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 3px solid #F0A020;
    border-radius: 12px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .notice[hidden] {
    display: none;
  }

  .notice.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .notice-dot {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    margin-top: 0.45rem;
    border-radius: 50%;
    background: #F0A020;
    box-shadow: 0 0 0 0 rgba(240, 160, 32, 0.6);
    animation: notice-pulse 2.4s ease-out infinite;
  }

  @keyframes notice-pulse {
    70% {
      box-shadow: 0 0 0 10px rgba(240, 160, 32, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(240, 160, 32, 0);
    }
  }

  .notice-body {
    flex: 1;
    min-width: 0;
  }

  .notice-title {
    margin: 0 0 0.3rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .notice-text {
    margin: 0 0 0.6rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .notice-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #F0A020;
    text-decoration: none;
  }

  .notice-link:hover {
    text-decoration: underline;
  }

  .notice-link svg {
    width: 13px;
    height: 13px;
  }

  .notice-close {
    flex-shrink: 0;
    align-self: flex-start;
    display: flex;
    padding: 0.25rem;
    background: none;
    border: none;
    border-radius: 6px;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }

  .notice-close:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .notice-close svg {
    width: 15px;
    height: 15px;
  }

  @media (max-width: 640px) {
    .notice {
      right: 1rem;
      left: 1rem;
      bottom: 4.25rem;
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notice {
      transition: none;
    }

    .notice-dot {
      animation: none;
    }
  }
</style>

<script>
  const notice = document.querySelector<HTMLElement>('[data-notice]');
  const id = notice?.dataset.notice;

  if (notice && id) {
    const key = `notice-dismissed:${id}`;
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(key) === '1';
    } catch {
      // Private mode / storage blocked: show the notice rather than fail closed.
    }

    if (!dismissed) {
      notice.hidden = false;
      // Let the hero land first, then slide the notice in.
      setTimeout(() => notice.classList.add('is-visible'), 700);

      notice.querySelector('[data-notice-dismiss]')?.addEventListener('click', () => {
        notice.classList.remove('is-visible');
        setTimeout(() => {
          notice.hidden = true;
        }, 350);
        try {
          localStorage.setItem(key, '1');
        } catch {
          /* dismissal just won't persist */
        }
      });
    }
  }
</script>
