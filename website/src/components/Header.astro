---
import DiscordIcon from './DiscordIcon.astro';
import { DISCORD_URL } from '../lib/site';

const baseUrl = import.meta.env.BASE_URL;
---

<header>
  <div class="container header-content">
    <a href="/" class="logo-group" aria-label="Tarkov Nexus home">
      <img src={`${baseUrl}ON-512-logo-transparent.png`} alt="" class="logo" width="40" height="40">
      <span class="logo-text">Tarkov Nexus</span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      <a href="#tour" data-analytics="nav" data-nav-item="tour">Tour</a>
      <a href="#features" data-analytics="nav" data-nav-item="features">Features</a>
      <a href="#how-it-works" data-analytics="nav" data-nav-item="how-it-works">How It Works</a>
      <a href="#download" data-analytics="nav" data-nav-item="download">Download</a>
      <a href="#beta" data-analytics="nav" data-nav-item="beta">Beta</a>
      <a href="#faq" data-analytics="nav" data-nav-item="faq">FAQ</a>
      <a href="https://github.com/ObsidianNetwork/Tarkov-Nexus/releases" target="_blank" rel="noopener" data-analytics="nav" data-nav-item="github">GitHub</a>
      <a href={DISCORD_URL} target="_blank" rel="noopener" class="btn-discord btn-discord--nav" data-analytics="nav" data-nav-item="discord">
        <DiscordIcon />
        Discord
      </a>
    </nav>
  </div>
</header>
