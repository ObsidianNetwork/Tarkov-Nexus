---
const baseUrl = import.meta.env.BASE_URL;
---

<footer>
  <div class="container footer-content">
    <div class="footer-left">
      <img src={`${baseUrl}ON-512-logo-transparent.png`} alt="Tarkov Nexus">
      <span>Tarkov Nexus is not affiliated with Battlestate Games</span>
    </div>
    <div class="footer-links">
      <a href="https://github.com/ObsidianNetwork/Tarkov-Nexus/releases" target="_blank" data-analytics="nav" data-nav-item="footer-github">GitHub</a>
      <a href="https://tarkov.dev" target="_blank" data-analytics="nav" data-nav-item="footer-tarkov-dev">tarkov.dev</a>
      <a href="https://github.com/ObsidianNetwork/Tarkov-Nexus/issues/new/choose" target="_blank" data-analytics="feedback" data-entry-point="footer">Feedback</a>
    </div>
  </div>
</footer>
