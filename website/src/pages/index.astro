---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tour from '../components/Tour.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Showcase from '../components/Showcase.astro';
import Download from '../components/Download.astro';
import FAQ, { faqs } from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL as siteUrl, DISCORD_URL, AUTHORS, githubProfile } from '../lib/site';

const repoUrl = 'https://github.com/ObsidianNetwork/Tarkov-Nexus';

const people = AUTHORS.map((a) => ({
  '@type': 'Person',
  name: a.name,
  alternateName: a.login,
  url: githubProfile(a.login)
}));

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Tarkov Nexus',
  alternateName: 'Tarkov Nexus Map Tracker',
  description:
    'Free, open-source live Tarkov map tracker that shows your real-time position on every Escape from Tarkov map by syncing in-game screenshot coordinates to tarkov.dev.',
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  screenshot: [
    `${siteUrl}/screens/dashboard.png`,
    `${siteUrl}/screens/party.png`,
    `${siteUrl}/screens/overlay-circle.png`
  ],
  isAccessibleForFree: true,
  license: 'https://opensource.org/license/mit',
  codeRepository: repoUrl,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Map Tool',
  operatingSystem: 'Windows 10, Windows 11',
  downloadUrl: 'https://github.com/ObsidianNetwork/Tarkov-Nexus/releases/latest',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  author: people,
  publisher: {
    '@type': 'Organization',
    name: 'Obsidian Network',
    url: 'https://github.com/ObsidianNetwork'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Obsidian Network',
  url: 'https://github.com/ObsidianNetwork',
  logo: `${siteUrl}/ON-512-logo-transparent.png`,
  sameAs: [repoUrl, DISCORD_URL],
  member: people
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tarkov Nexus',
  alternateName: ['TarkovNexus', 'Tarkov Nexus Map Tracker'],
  url: `${siteUrl}/`,
  description: 'Free live Tarkov map tracker. See your real-time position on every Escape from Tarkov map.'
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer
    }
  }))
};
---

<Layout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />
  <main id="main">
    <Hero />
    <Tour />
    <Features />
    <HowItWorks />
    <Showcase />
    <Download />
    <FAQ />
  </main>
  <Footer />
</Layout>
