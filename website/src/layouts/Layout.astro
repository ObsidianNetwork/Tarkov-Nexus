---
import '../styles/global.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import Analytics from '../components/Analytics.astro';
import FeedbackButton from '../components/FeedbackButton.astro';
import { SITE_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "Tarkov Nexus: Free Live Tarkov Map Tracker",
  description = "Tarkov Nexus is a free, open-source live Tarkov map tracker. See your real-time position on every Escape from Tarkov map, share it with your squad, and sync it to tarkov.dev.",
  image = "/og-image.png",
  noindex = false
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;
const imageAlt = "Tarkov Nexus, the free live Tarkov map tracker";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="tarkov map, escape from tarkov map, tarkov live map, tarkov map tracker, tarkov position tracker, tarkov map sync, tarkov.dev map, tarkov customs map, tarkov woods map, tarkov shoreline map, tarkov lighthouse map, tarkov reserve map, tarkov streets map, EFT map, tarkov interactive map">
  <meta name="author" content="Jordan (Jordanmuss99), uBlue (ImStillBlue)">
  <meta name="application-name" content="Tarkov Nexus">
  <meta name="apple-mobile-web-app-title" content="Tarkov Nexus">
  <meta name="theme-color" content="#0C0E14">
  <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1"}>

  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`}>
  <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}ON-512-logo-transparent.png`}>
  <link rel="apple-touch-icon" href={`${baseUrl}ON-512-logo-transparent.png`}>
  <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`}>

  <!-- Performance: preconnect to third-party hosts we hit -->
  <link rel="preconnect" href="https://api.github.com" crossorigin>
  <link rel="dns-prefetch" href="https://github.com">
  <link rel="dns-prefetch" href="https://tarkov.dev">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Tarkov Nexus">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content={imageAlt}>
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>
  <meta name="twitter:image:alt" content={imageAlt}>

  <slot name="head" />

  <!-- Marks scripting as available before first paint; reveal styles key off it. -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <Analytics />
</head>
<body>
  <div class="bg-gradient"></div>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
  <FeedbackButton />

  <script>
    // Scroll reveal: mark sections/cards visible as they enter the viewport.
    // Reduced-motion users get the final state immediately via CSS.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('.reveal');

    if (reduceMotion || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
      );
      targets.forEach((el) => observer.observe(el));
    }
  </script>
</body>
</html>
